# Skopiuj do .env i uzupełnij wartości produkcyjne.
# Każdy apps/* wczytuje tylko swoje zmienne.

# apps/server
SERVER_PORT=3001
POSTGRES_URL=postgresql://webapi:webapi@localhost:5432/webapi_tester
# Baza używana wyłącznie przez testy integracyjne (kontener postgres-test, port 5433).
# Testy czyszczą ją przez TRUNCATE, baza deweloperska pozostaje nietknięta.
POSTGRES_TEST_URL=postgresql://webapi:webapi@localhost:5433/webapi_tester_test
JWT_SECRET_KEY=dev-secret-change-in-deployment-must-be-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# apps/proxy
PROXY_PORT=3002
PROXY_SHARED_SECRET=dev-shared-secret-change-in-deployment

# apps/web (zmienne Vite - prefix VITE_)
WEB_PORT=5173
VITE_API_BASE=http://localhost:3001
VITE_PROXY_URL=http://localhost:3002
VITE_PROXY_SHARED_SECRET=dev-shared-secret-change-in-deployment