# Skopiuj do .env i uzupełnij wartości produkcyjne.
# Każdy apps/* wczytuje tylko swoje zmienne.

# apps/server
NODE_ENV=development
SERVER_PORT=3001
# Platforma chmurowa (Render) wstrzykuje PORT, dlatego serwer używa PORT,
# a gdy go nie ma, korzysta z SERVER_PORT.
# PORT=3001
# Adres nasłuchu. Domyślnie 0.0.0.0, co poprawnie działa zarówno
# lokalnie, jak i na platformie chmurowej.
# BIND_HOST=0.0.0.0
# Lista originów frontu, dla których API dopuszcza żądania CORS (po przecinku).
# Pusta wartość oznacza tryb deweloperski, w którym API odbija każdy origin.
# WEB_ORIGIN=https://webapi-tester.onrender.com
# Katalog ze zbudowanym frontendem. Gdy pusty, serwer szuka go w repozytorium
# (apps/web/dist), więc zwykle nie trzeba go ustawiać.
# WEB_DIST_DIR=
# Lista hostów, z których wolno importować specyfikację OpenAPI (po przecinku).
# Pusta wartość dopuszcza dowolny host publiczny, ale blokuje sieć wewnętrzną.
# OPENAPI_IMPORT_ALLOWED_HOSTS=
# Koszt bcrypta. Na wolnym planie Render (0,1 CPU) warto obniżyć do 10,
# bo hashowanie w czystym JavaScript jest wtedy zauważalnie wolniejsze.
BCRYPT_COST=12
# Baza deweloperska w kontenerze. W produkcji adres z Neon:
# postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://webapi:webapi@localhost:5432/webapi_tester
# Baza używana wyłącznie przez testy integracyjne (kontener postgres-test, port 5433).
# Testy czyszczą ją przez TRUNCATE, baza deweloperska pozostaje nietknięta.
POSTGRES_TEST_URL=postgresql://webapi:webapi@localhost:5433/webapi_tester_test
JWT_SECRET_KEY=dev-secret-change-in-deployment-must-be-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# apps/proxy
PROXY_PORT=3002
# Adres nasłuchu: 127.0.0.1 dla procesu uruchomionego na maszynie użytkownika,
# 0.0.0.0 wewnątrz kontenera (port publikowany wyłącznie na 127.0.0.1 hosta).
PROXY_BIND_HOST=127.0.0.1
# Plik z kluczem współdzielonym. Gdy PROXY_SHARED_SECRET nie jest ustawiony,
# agent generuje klucz przy pierwszym starcie i zapisuje go w tym pliku.
PROXY_KEY_FILE=.webapi-tester-agent-key
PROXY_SHARED_SECRET=dev-shared-secret-change-in-deployment

# apps/web (zmienne Vite - prefix VITE_)
WEB_PORT=5173
# Adres backendu. W wdrożeniu publicznym frontend i API są serwowane
# z jednego adresu, więc API_BASE to ścieżka względna (/api).
VITE_API_BASE=http://localhost:3001/api
# Adres agenta proxy. Można go też zmienić w interfejsie (przycisk "Agent proxy").
VITE_PROXY_URL=http://localhost:3002
# Klucz agenta. Ustawienie go w .env jest opcjonalne: klucz można wkleić
# w interfejsie (przycisk "Agent proxy"), a bez klucza aplikacja wysyła
# żądania wprost z przeglądarki.
VITE_PROXY_SHARED_SECRET=
