{
  "name": "webapi-tester",
  "version": "0.1.0",
  "private": true,
  "description": "WebAPI Tester - prototype webowego testera REST API z lokalnym proxy",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "migrate": "pnpm --filter @webapi-tester/server run migrate",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20"
  }
}